# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://xenovarients_app:xenovarients_app@localhost:55432/xenovarients
DB_ECHO=false

# Migrations run as the schema owner (DDL rights). The app role cannot ALTER/DROP.
MIGRATION_DATABASE_URL=postgresql+asyncpg://xenovarients:xenovarients@localhost:55432/xenovarients

REDIS_URL=redis://localhost:56379/0

MONGO_URI=mongodb://localhost:57017
MONGO_DB_NAME=xenovarients
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
LLM_CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.35
LLM_MAX_CONCURRENCY=2

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Provider secrets — leave empty until the feature is enabled.
META_APP_SECRET=
META_APP_ID=
SMS_GATEWAY_KEY=
EMAIL_API_KEY=
EMAIL_FROM_DOMAIN=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MAX_DELIVERY_ATTEMPTS=3
DELIVERY_RETRY_BASE_SECONDS=30
